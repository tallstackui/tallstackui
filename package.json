{
  "name": "tallstackui",
  "description": "TallStack UI Components",
  "repository": "git@github.com:tallstackui/tallstackui.git",
  "author": "AJ Meireles <alvaro.meireles@live.com>",
  "license": "MIT",
  "scripts": {
    "build": "vite build && npx @tailwindcss/cli -i css/v4.css -o ./dist/tallstackui.css --minify",
    "dev": "vite build --watch",
    "lint": "npx eslint \"js/**\" \"src/Components/**/*.js\"",
    "lint:fix": "npx eslint \"js/**\" \"src/Components/**/*.js\" --fix",
    "format": "npx prettier --write \"js/**/*.js\" \"src/Components/**/*.js\""
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.22.0",
    "@tailwindcss/forms": "^0.5.11",
    "eslint": "^10.5.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "tippy.js": "^6.3.7",
    "vite": "^8.1.0"
  },
  "dependencies": {
    "@alpinejs/collapse": "^3.15.12",
    "@tailwindcss/vite": "^4.3.1",
    "clipboard": "^2.0.11",
    "dayjs": "^1.11.21",
    "qs": "^6.15.3"
  }
}
